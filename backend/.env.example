# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Secret used to sign login tokens. Use a long random string in production,
# e.g. generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
CIRQLE_SECRET_KEY=change-me-to-a-long-random-string

# Database. Leave DATABASE_URL unset for local dev (uses the SQLite file below).
# In production set DATABASE_URL to the Amazon RDS PostgreSQL connection string:
#   DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@ENDPOINT:5432/DBNAME
# When DATABASE_URL is set, CIRQLE_DB_PATH is ignored.
CIRQLE_DB_PATH=cirqle.db

# Which website origins may call this API. "*" is fine for local dev because we
# authenticate with a bearer token (no cookies). Lock this down in production,
# e.g. CIRQLE_CORS_ORIGINS=https://cirqle.example.com
CIRQLE_CORS_ORIGINS=*

# Apify API token, used server-side to scrape Instagram mentions for the feed.
# Get it from Apify → Settings → Integrations → API tokens. This stays on the
# server and is NEVER sent to the browser.
APIFY_TOKEN=

# Instagram account whose mentions we scrape (posts that tag it). Optional.
CIRQLE_BRAND_HANDLE=cirqle.ltd

# ── Campaigns (Phase 3) ──
# Shared key required to create/edit/delete campaigns (sent as the X-Admin-Key
# header). Use a long random string in production.
CIRQLE_ADMIN_KEY=dev-admin-key

# Campaign image storage. Leave S3_BUCKET unset for local dev — images are then
# saved under backend/media/ and served by the API at /media. In production set
# S3_BUCKET (+ AWS_REGION) and give the server IAM permission to PutObject.
S3_BUCKET=
AWS_REGION=eu-west-2

# Base URL the LOCAL-mode images are reachable at (ignored when S3_BUCKET is set).
# Should point at this API, e.g. http://localhost:8000 locally.
CIRQLE_MEDIA_BASE=http://localhost:8000

# ── Receipts (Phase 4) ──
# PRIVATE bucket for user receipt photos (block all public access ON). Leave
# unset for local dev — receipts are then saved under backend/receipts/. Give the
# server IAM PutObject on this bucket. Personal data: never made public.
S3_RECEIPTS_BUCKET=

# ── Transactional email (verification links, password resets) ──
# console = print emails to the server log instead of sending (local dev, and
# safe on the server before SES production access is granted). ses = send for
# real through Amazon SES in AWS_REGION.
CIRQLE_EMAIL_MODE=console
CIRQLE_EMAIL_FROM=Cirqle <noreply@cirqle.co.uk>

# Base URL of the WEBSITE (not this API) — used to build the links inside those
# emails, e.g. https://cirqle.co.uk/reset-password.html?token=...
CIRQLE_SITE_BASE=https://cirqle.co.uk

# ── Automated receipt check (Phase 8, superseded by Claude-vision verification
# below as the automatic pipeline — still reachable manually via
# POST /receipts/{id}/recheck) ──
# Reads each uploaded receipt with Amazon Textract (AnalyzeExpense) in
# AWS_REGION and scores it against the deal, for the admin to see while
# reviewing. Advisory only — it approves nothing.
#
# Needs the "textract:AnalyzeExpense" IAM permission on the server's role;
# nothing else to configure, and no data leaves the AWS account. First 150
# pages a month are free.
#
# This same flag now gates the Claude-vision pipeline below instead (same
# name, kept so existing local setups don't need to change). Set to "off" to
# skip it entirely (useful in local dev with no ANTHROPIC_API_KEY, where
# every check would otherwise record an error).
CIRQLE_RECEIPT_CHECK=on

# ── Claude-vision receipt verification (HITL) — app/receipt_verification.py ──
# Compares each new receipt against the merchant's stored reference receipt
# (authenticity of origin) and the claimed campaign (purchase correctness) in
# one Claude vision call, then either auto-approves (only if
# AUTO_APPROVAL_ENABLED=true and the score clears the threshold) or routes to
# the admin queue (GET /receipts/admin/manual-review). A failed call ALWAYS
# routes to the admin queue, never auto-approves.
ANTHROPIC_API_KEY=
VERIFICATION_MODEL=claude-sonnet-5
# Hamming-distance threshold for the perceptual-hash duplicate check (lower = stricter).
IMAGE_HASH_THRESHOLD=5
VERIFICATION_AUTO_APPROVE_THRESHOLD=0.85
# Kill switch. false = every claim routes to the admin queue regardless of
# score (the pipeline still runs and scores it, just never auto-decides).
# Flip to true only after comparing real scores against real admin decisions
# for a while (see GET /receipts/admin/auto-approved for a spot-check trail).
AUTO_APPROVAL_ENABLED=false
